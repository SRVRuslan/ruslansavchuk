<style>
  svg { display: block; width: 100%; height: auto; }
  .candlelight { opacity: .85; animation: pumpkin-candlelight 6.7s ease-in-out infinite; }
  .ground-reflection { opacity: .7; animation: pumpkin-candlelight 6.7s ease-in-out infinite; }
  .candle-flame { transform-box: view-box; transform-origin: 120px 184px; animation: pumpkin-flame 2.9s ease-in-out infinite; }
  @keyframes pumpkin-candlelight {
    0%, 100% { opacity: .82; }
    13% { opacity: .96; }
    27% { opacity: .73; }
    38% { opacity: .9; }
    61% { opacity: .78; }
    76% { opacity: 1; }
    89% { opacity: .86; }
  }
  @keyframes pumpkin-flame {
    0%, 100% { transform: skewX(-4deg) scaleY(.92); }
    35% { transform: skewX(5deg) scaleY(1.06); }
    65% { transform: skewX(-2deg) scaleY(.96); }
  }
  @media (prefers-reduced-motion: reduce) {
    .candlelight, .ground-reflection, .candle-flame { animation: none; }
  }
</style>
