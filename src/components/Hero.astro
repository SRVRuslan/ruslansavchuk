---
import HeroGlobe from './HeroGlobe.astro';
import HalloweenDecor from './HalloweenDecor.astro';
import ChristmasDecor from './ChristmasDecor.astro';
---
<section class="hero container" id="home" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <div class="availability availability-halloween"><span class="status-dot" aria-hidden="true"></span><svg class="halloween-mini" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 7c-3-3-5-1-6 0-4-1-5 3-4 7 1 5 5 7 10 6 5 1 9-1 10-6 1-4 0-8-4-7-1-1-3-3-6 0Z" stroke="currentColor" stroke-width="1.5" /><path d="M12 7c2-2 2-4 1-5M6 12l3-2 1 3-4-1Zm12 0-3-2-1 3 4-1ZM7 16c3 3 7 3 10 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg><svg class="christmas-mini" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2v20M3.3 7l17.4 10M3.3 17l17.4-10M9 4l3 3 3-3M9 20l3-3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg><span data-i18n="availability">Беру нові проєкти</span></div>
          <h1 id="hero-heading"><span data-i18n="heroLine1">Сучасні сайти.</span><br /><span class="highlight" data-i18n="heroLine2">Для бізнесу.</span><svg class="hero-spark" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M32 3v58M3 32h58M11.5 11.5l41 41m0-41-41 41" stroke="currentColor" stroke-width="8" /></svg></h1>
          <p class="hero-description" data-i18n="heroDescription">Створюю швидкі, стильні сайти, які презентують ваш бізнес, викликають довіру та допомагають залучати клієнтів.</p>
          <div class="hero-actions"><a class="button button-dark" href="#contact"><span data-i18n="discussProject">Обговорити сайт</span><span aria-hidden="true">↗</span></a><a class="text-link" href="#work"><span data-i18n="viewWork">Приклади робіт</span><span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <HeroGlobe />
          <HalloweenDecor />
          <ChristmasDecor />
          <div class="art-grid"></div>
          <div class="code-window" dir="ltr"><div class="window-bar"><span class="window-dots"><i></i><i></i><i></i></span><span>something-great.tsx</span><span>⌘</span></div><div class="code-body"><div class="line-numbers">01<br />02<br />03<br />04<br />05<br />06<br />07<br />08<br />09</div><code><span class="code-purple">const</span> yourNextWebsite = &#123;<br />&nbsp;&nbsp;design: <span class="code-green">'thoughtful'</span>,<br />&nbsp;&nbsp;experience: <span class="code-green">'effortless'</span>,<br />&nbsp;&nbsp;details: <span class="code-green">'matter'</span>,<br />&nbsp;&nbsp;possibilities: <span class="code-orange">Infinity</span>,<br />&#125;;<br /><br /><span class="code-purple">let's</span> buildSomething(<br />&nbsp;&nbsp;<span class="code-green">'extraordinary'</span><br />);</code></div></div>
          <div class="preview-window"><div class="preview-toolbar" dir="ltr"><span class="window-dots"><i></i><i></i><i></i></span><span>your-next-big-thing.com</span><span>↗</span></div><div class="preview-content"><div class="preview-topline"><b dir="ltr">hello®</b><span data-i18n="previewTagline">MADE TO MAKE A DIFFERENCE</span></div><div class="preview-title"><span data-i18n="previewTitleLine1">Good things.</span><br /><span class="preview-title-accent" data-i18n="previewTitleLine2">Start here.</span></div><div class="asterisk"><span></span><span></span><span></span><span></span><span></span><span></span></div><div class="preview-bottom"><span data-i18n="previewCta">LET’S MAKE IT HAPPEN</span><span class="preview-arrow">↗</span></div></div></div>
          <div class="art-sticker"><span>↗</span><div data-i18n="artSticker">Ваш бізнес.<br />Ваш новий сайт.</div></div><span class="art-coordinate art-coordinate-bottom">&lt; / &gt;</span>
        </div>
      </section>

<style>
  .code-window, .preview-window { scale: .8; }
  :global(html[data-halloween]) .availability-halloween { border-color: #bc79384d; background: #bd6a1710; }
  .halloween-mini { display: none; width: 18px; height: 18px; flex-shrink: 0; color: #efb177; }
  :global(html[data-halloween]) .halloween-mini { display: block; }
  :global(html[data-halloween]) .availability > .status-dot { display: none; }
  :global(html[data-christmas]) .availability { border-color: #c7a76b55; background: #bf9b5010; }
  .christmas-mini { display: none; width: 18px; height: 18px; flex-shrink: 0; color: #e3c588; }
  :global(html[data-christmas]) .christmas-mini { display: block; }
  :global(html[data-christmas]) .availability > .status-dot { display: none; }
  .hero-copy h1 {
    display: block;
    width: fit-content;
    margin-top: 24px;
  }

  .hero-copy h1:lang(pl) .hero-spark {
    top: -26px;
    right: 0;
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .hero-copy h1:lang(pl) {
      font-size: clamp(34px, 5.2vw, 44px);
    }
  }

  @media (max-width: 640px) {
    .hero-art {
      max-width: none;
      height: auto;
      aspect-ratio: 1;
      margin-top: 28px;
    }
    .art-grid { inset: 0; }
    .code-window, .preview-window {
      height: auto;
      aspect-ratio: 1.74;
      scale: .76;
    }
    .code-window { width: 82%; left: 0; top: 18%; }
    .preview-window { width: 78%; left: 18%; top: 43%; }
    .window-bar, .preview-toolbar {
      height: clamp(20px, 5vw, 30px);
      padding-inline: clamp(9px, 2.6vw, 16px);
      font-size: clamp(6px, 1.35vw, 8px);
    }
    .code-body {
      padding: clamp(7px, 2vw, 12px);
      gap: clamp(8px, 2.5vw, 16px);
      font-size: clamp(6px, 1.9vw, 11px);
      line-height: 1.65;
    }
    .preview-content {
      height: calc(100% - clamp(20px, 5vw, 30px));
      padding: clamp(9px, 2.7vw, 17px);
    }
    .preview-topline b { font-size: clamp(11px, 3vw, 18px); }
    .preview-topline > span { font-size: clamp(3px, .8vw, 5px); }
    .preview-title {
      max-width: 70%;
      margin-top: clamp(10px, 2.7vw, 16px);
      font-size: clamp(21px, 6vw, 36px);
      letter-spacing: -1px;
    }
    .preview-title:lang(ar) { font-size: clamp(17px, 5.1vw, 30px); line-height: 1.3; }
    .asterisk {
      width: clamp(42px, 13.5vw, 84px);
      height: clamp(42px, 13.5vw, 84px);
      right: 6%;
      top: 32%;
      transform: rotate(-10deg);
    }
    .asterisk > span { height: 100%; width: 30%; left: 35%; }
    .asterisk:lang(ar) { left: 6%; right: auto; }
    .preview-bottom {
      position: absolute;
      align-items: flex-end;
      left: clamp(9px, 2.7vw, 17px);
      right: clamp(9px, 2.7vw, 17px);
      bottom: clamp(9px, 2.7vw, 17px);
      margin-top: 0;
      font-size: clamp(4px, 1.1vw, 6px);
    }
    .preview-arrow { width: clamp(20px, 5.8vw, 30px); height: clamp(20px, 5.8vw, 30px); font-size: clamp(16px, 4.5vw, 23px); }
    .art-sticker { top: 4%; right: 1%; scale: .8; transform-origin: top right; }
    .art-coordinate-bottom { bottom: 2%; right: 3%; }
    .preview-title-accent:lang(pt),
    .preview-title-accent:lang(it),
    .preview-title-accent:lang(pl) {
      font-size: .9em;
    }
  }

  @media (max-width: 360px) {
    .hero-copy h1:lang(de),
    .hero-copy h1:lang(pl) {
      font-size: clamp(32px, 10vw, 36px);
    }
    .hero-spark {
      top: -20px;
      right: 0;
    }
  }
</style>
