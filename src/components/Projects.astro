---
import { Image } from 'astro:assets';
import mechanicalImage from '../../public/assets/17-mechanical.jpg';
import cleaningImage from '../../public/assets/care-clean-home.jpg';
import roofingImage from '../../public/assets/peakline-roofing.jpg';

const projectSizes = '(max-width: 360px) calc(100vw - 72px), (max-width: 640px) calc(100vw - 90px), (max-width: 900px) calc((100vw - 148px) / 2), (max-width: 1328px) calc((100vw - 224px) / 2), 552px';
const roofingSizes = '(max-width: 360px) calc(100vw - 72px), (max-width: 640px) calc(100vw - 90px), (max-width: 900px) calc((100vw - 48px) * .56), (max-width: 1328px) calc((100vw - 72px) * .56), 698px';
---
<section class="section container" id="work" aria-labelledby="work-heading">
        <div class="section-top"><p class="eyebrow"><span data-i18n="workEyebrow">ОБРАНІ РОБОТИ</span></p><span class="section-side-note" data-i18n="workSide">Менше слів. Більше того, що можна побачити.</span></div>
        <div class="section-heading-row"><h2 id="work-heading" data-i18n="workHeading">Різні ідеї. Один підхід.</h2><div class="project-filters" role="group" aria-label="Фільтрувати проєкти" data-i18n-aria="filterLabel"><button type="button" data-filter="all" aria-pressed="true" data-i18n="filterAll">Усі</button><button type="button" data-filter="website" aria-pressed="false" data-i18n="filterWeb">Вебсайти</button><button type="button" data-filter="app" aria-pressed="false" data-i18n="filterApp">Застосунки</button></div></div>
        <div class="projects-grid" id="projects-grid">
          <article class="project-card" data-category="website">
            <a class="project-open" href="https://17mechanical.ca/" target="_blank" rel="noopener noreferrer" aria-label="Відкрити сайт 17 Mechanical у новій вкладці" data-i18n-aria="mechanicalProjectLink">
              <div class="project-art project-art-mechanical">
                <span class="concept-badge" data-i18n="photoProjectBadge">Реалізований проєкт</span>
                <Image src={mechanicalImage} widths={[320, 640, 960, 1280, 1440]} sizes={projectSizes} quality={82} width="1440" height="1000" loading="lazy" decoding="async" alt="Головна сторінка 17 Mechanical — компанії з опалення, вентиляції та кондиціонування в Калгарі" data-i18n-alt="mechanicalProjectAlt" />
                <span class="project-open-icon" aria-hidden="true">↗</span>
              </div>
              <div class="project-info"><div><h3 dir="auto">17 Mechanical</h3><p data-i18n="mechanicalProjectSubtitle">Сайт компанії з опалення та кондиціонування в Калгарі</p></div><span class="project-type" data-i18n="website">Вебсайт</span></div>
            </a>
          </article>
          <article class="project-card" data-category="website"><a class="project-open" href="https://carecleanhome.ca/" target="_blank" rel="noopener noreferrer" aria-label="Відкрити сайт Care &amp; Clean Home у новій вкладці" data-i18n-aria="careCleanProjectLink"><div class="project-art project-art-careclean"><span class="concept-badge" data-i18n="photoProjectBadge">Реалізований проєкт</span><Image src={cleaningImage} widths={[320, 640, 960, 1280, 1440]} sizes={projectSizes} quality={82} width="1440" height="1026" loading="lazy" decoding="async" alt="Головна сторінка Care &amp; Clean Home — клінінгової компанії в Калгарі" data-i18n-alt="careCleanProjectAlt" /><span class="project-open-icon" aria-hidden="true">↗</span></div><div class="project-info"><div><h3 dir="auto">Care &amp; Clean Home</h3><p data-i18n="careCleanProjectSubtitle">Сайт клінінгової компанії в Калгарі</p></div><span class="project-type" data-i18n="website">Вебсайт</span></div></a></article>
          <article class="project-card project-card-wide" data-category="website">
            <a class="project-open" href="https://roofing.ruslan-savchuk-dev-ca.workers.dev/" target="_blank" rel="noopener noreferrer" aria-label="Відкрити сайт Peakline Roofing у новій вкладці" data-i18n-aria="roofingProjectLink">
              <div class="project-art project-art-roofing">
                <span class="concept-badge" data-i18n="concept">Дизайн-концепт</span>
                <div class="roofing-intro" aria-hidden="true"><span class="roofing-brand" dir="ltr">PEAKLINE<span>ROOFING</span></span><span class="roofing-tagline" data-i18n="roofingArt">Створено для Альберти.<br />Створено надовго.</span></div>
                <Image src={roofingImage} widths={[320, 640, 960, 1280, 1440]} sizes={roofingSizes} quality={82} width="1440" height="1000" loading="lazy" decoding="async" alt="Головна сторінка Peakline Roofing — покрівельної компанії в Калгарі" data-i18n-alt="roofingProjectAlt" />
                <span class="project-open-icon" aria-hidden="true">↗</span>
              </div>
              <div class="project-info"><div><h3 dir="auto">Peakline Roofing</h3><p data-i18n="roofingProjectSubtitle">Сайт покрівельної компанії в Калгарі</p></div><span class="project-type" data-i18n="website">Вебсайт</span></div>
            </a>
          </article>
        </div>
        <p class="concept-note"><span aria-hidden="true">↳</span><span data-i18n="conceptNote">Реалізовані проєкти й авторські концепти, що демонструють мій підхід до дизайну. Місце для ваших майбутніх історій успіху.</span></p>
        <div class="projects-pagination" id="projects-pagination" hidden>
          <button class="projects-more" id="projects-more" type="button" aria-controls="projects-grid" hidden>
            <span data-i18n="viewMoreProjects">Переглянути більше</span>
            <span class="projects-more-count" id="projects-more-count" dir="ltr"></span>
            <span class="projects-more-arrow" aria-hidden="true">↓</span>
          </button>
          <p class="projects-count" id="projects-count" role="status" aria-live="polite" aria-atomic="true"></p>
          <div class="projects-progress" aria-hidden="true"><span id="projects-progress-fill"></span></div>
        </div>
      </section>
