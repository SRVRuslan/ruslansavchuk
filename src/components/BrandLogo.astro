---
import { Image } from 'astro:assets';
import rsMark from '../../public/assets/rs-mark.webp';

interface Props {
  footer?: boolean;
}

const { footer = false } = Astro.props;
---
<a class:list={['logo', 'rs-logo', { 'footer-logo': footer }]} href="#home" dir="ltr" aria-label="Ruslan Savchuk — Web Developer · Software Engineer — на головну">
  <span class="rs-logo-symbol" aria-hidden="true"><Image class="rs-logo-mark" src={rsMark} widths={[88, 176, 264]} sizes={footer ? '(max-width: 640px) 44px, (max-width: 900px) 66px, 88px' : '(max-width: 640px) 54px, (max-width: 900px) 70px, 90px'} quality={85} loading={footer ? 'lazy' : 'eager'} fetchpriority={footer ? 'auto' : 'high'} alt="" aria-hidden="true" decoding="async" /></span>
  <span class="rs-wordmark" aria-hidden="true">
    <span class="rs-logo-name">RUSLAN <strong>SAVCHUK</strong></span>
    <span class="rs-logo-role"><span data-i18n="brandDeveloper">WEB DEVELOPER</span> <span class="rs-role-divider">•</span> <span data-i18n="brandEngineer">SOFTWARE ENGINEER</span></span>
  </span>
</a>
