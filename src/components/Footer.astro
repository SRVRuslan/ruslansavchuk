---
import BrandLogo from './BrandLogo.astro';
import config from '../data/config.js';
---
<footer class="site-footer">
      <div class="container">
        <div class="footer-overview">
          <div class="footer-summary">
            <BrandLogo footer />
            <p class="footer-tagline" data-i18n="footerTagline">Продумано. Розроблено. З любов’ю до деталей.</p>
            <a class="footer-email" id="footer-email" dir="ltr" hidden><span></span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
          <nav class="footer-navigation" aria-label="Навігація у футері" data-i18n-aria="footerNavigation">
            <h2 class="footer-heading" data-i18n="footerNavigationHeading">Навігація</h2>
            <a href="#work" data-i18n="navWork">Роботи</a>
            <a href="#services" data-i18n="navServices">Послуги</a>
            <a href="#about" data-i18n="navAbout">Про мене</a>
            <a href="#contact" data-i18n="letsTalk">Зв’яжіться з нами</a>
          </nav>
          <div class="footer-connect">
            <h2 class="footer-heading" data-i18n="footerConnect">Будьмо на зв’язку</h2>
            <p class="footer-social-caption" data-i18n="footerSocialCaption">Напишіть мені — обговорімо ваш проєкт.</p>
            <div class="footer-social-list" id="social-links">
              <a class="footer-social-icon" href="mailto:ruslan.savchuk.dev.ca@gmail.com" aria-label="Написати листа" data-i18n-aria="emailLinkLabel" title="ruslan.savchuk.dev.ca@gmail.com">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.7" /><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              {config.social.whatsapp && (
                <a class="footer-social-icon" href={config.social.whatsapp} data-social="whatsapp" title="WhatsApp" aria-label="WhatsApp — відкрити в новій вкладці" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.45L3 20.5l1.45-4.7A8.5 8.5 0 1 1 20.5 11.6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="m8.5 7.2-1.3.6c-.6 2.8 3.8 7.2 6.6 7.4l1.3-1.3-2.3-1.5-1 .8a7.9 7.9 0 0 1-3-3l.8-1-1.1-2Z" fill="currentColor" stroke="currentColor" stroke-width=".5" stroke-linejoin="round" /></svg>
                </a>
              )}
            </div>
          </div>
        </div>
        <div class="footer-credits">
          <p class="footer-copyright">© <span id="year" dir="ltr">2026</span> <span data-owner>Руслан Савчук</span><span class="footer-rights" data-i18n="rights">Усі права захищено.</span></p>
          <p class="footer-author"><span data-i18n="footerCredit">СТВОРЕНО ТА РОЗРОБЛЕНО</span><a class="footer-author-link" dir="ltr" href="https://ruslansavchuk.com"><img class="footer-author-mark" src="/assets/rs-mark.webp" width="640" height="364" alt="" aria-hidden="true" decoding="async" /><span>ruslansavchuk.com</span></a></p>
          <a class="footer-to-top" href="#home" aria-label="Нагору" data-i18n-aria="backTop"><span data-i18n="backTop">Нагору</span><span class="footer-top-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 19V5m-6 6 6-6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
        </div>
      </div>
    </footer>
