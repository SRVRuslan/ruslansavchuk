---
import HalloweenWeb from './HalloweenWeb.astro';
import globePoster from '../assets/globe/earth-poster.webp';
import globePosterMobile from '../assets/globe/earth-poster-512.webp';
---
<div class="hero-globe" aria-hidden="true">
  <picture class="globe-poster">
    <source media="(max-width: 900px)" srcset={globePosterMobile.src} />
    <img src={globePoster.src} width="768" height="768" alt="" decoding="async" fetchpriority="high" />
  </picture>
  <canvas data-hero-globe width="600" height="600"></canvas>
  <canvas data-globe-network width="600" height="600"></canvas>
  <HalloweenWeb />
</div>

<style>
  .hero-globe {
    position: absolute;
    z-index: -1;
    top: -95px;
    /* Keep the existing offset where there is room, within the page gutter. */
    right: max(-7%, min(-36px, calc((1256px - 100vw) / 2)));
    width: 120.96%;
    max-width: 691.2px;
    translate: 0 -3.703704%;
    aspect-ratio: 1;
    pointer-events: none;
    opacity: .95;
    /* Fade the lower hemisphere into the existing background. */
    mask-image: linear-gradient(#000 70%, #000c 87%, transparent 100%);
  }

  canvas, .globe-poster {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .globe-poster img { display: block; width: 100%; height: 100%; }

  canvas { opacity: 0; }
  .hero-globe[data-globe-ready] canvas { opacity: 1; }
  .hero-globe[data-globe-ready] .globe-poster { visibility: hidden; }

  .globe-poster, canvas[data-globe-network] {
    position: absolute;
    inset: 0;
  }

  @media (max-width: 900px) {
    .hero-globe { right: max(-7%, -24px); }
  }

  @media (max-width: 640px) {
    .hero-globe {
      top: -42px;
      left: 50%;
      right: auto;
      width: calc(100vw - 8px);
      max-width: none;
      translate: -50% 0;
      opacity: .9;
    }
    :global(html[dir=rtl]) .hero-globe { left: 50%; right: auto; }
  }
</style>

<script>
  import '../scripts/globe.js';
</script>
