---
import BrandLogo from './BrandLogo.astro';
import GlobeIcon from './GlobeIcon.astro';
---
<header class="header">
      <div class="container header-inner">
        <BrandLogo />
        <nav class="desktop-nav" aria-label="Основна навігація" data-i18n-aria="navigation">
          <a href="#work" data-i18n="navWork">Роботи</a>
          <a href="#services" data-i18n="navServices">Послуги</a>
          <a href="#about" data-i18n="navAbout">Про мене</a>
        </nav>
        <div class="header-actions">
          <div class="language-switch" role="group" aria-label="Мова сайту" data-i18n-aria="languageLabel">
            <button class="language-toggle" type="button" aria-expanded="false" aria-controls="language-options" aria-label="Мова сайту: Українська" lang="uk"><GlobeIcon /><span id="current-language" dir="ltr">UA</span><svg class="language-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
            <div class="language-options" id="language-options" hidden>
              <button type="button" data-lang="uk" aria-pressed="true" lang="uk" hidden><span class="language-option-icon" aria-hidden="true"><svg viewBox="0 0 24 16" focusable="false"><path fill="#0057b7" d="M0 0h24v8H0z" /><path fill="#ffd700" d="M0 8h24v8H0z" /></svg></span><span>Українська</span></button>
              <button type="button" data-lang="en" aria-pressed="false" lang="en"><span class="language-option-icon" aria-hidden="true"><GlobeIcon /></span><span>English</span></button>
              <button type="button" data-lang="fr" aria-pressed="false" lang="fr"><span class="language-option-icon" aria-hidden="true"><svg viewBox="0 0 24 16" focusable="false"><path fill="#002395" d="M0 0h8v16H0z" /><path fill="#fff" d="M8 0h8v16H8z" /><path fill="#ed2939" d="M16 0h8v16h-8z" /></svg></span><span>Français</span></button>
              <button type="button" data-lang="es" aria-pressed="false" lang="es"><span class="language-option-icon" aria-hidden="true"><svg viewBox="0 0 24 16" focusable="false"><path fill="#aa151b" d="M0 0h24v16H0z" /><path fill="#f1bf00" d="M0 4h24v8H0z" /></svg></span><span>Español</span></button>
              <button type="button" data-lang="de" aria-pressed="false" lang="de"><span class="language-option-icon" aria-hidden="true"><svg viewBox="0 0 30 18" focusable="false"><path fill="#000" d="M0 0h30v18H0z" /><path fill="#d00" d="M0 6h30v6H0z" /><path fill="#ffce00" d="M0 12h30v6H0z" /></svg></span><span>Deutsch</span></button>
              <button type="button" data-lang="pt" aria-pressed="false" lang="pt"><span class="language-option-icon" aria-hidden="true"><svg viewBox="0 0 30 20" focusable="false"><path fill="#f00" d="M0 0h30v20H0z" /><path fill="#060" d="M0 0h12v20H0z" /><circle cx="12" cy="10" r="5" fill="none" stroke="#ffcc00" stroke-width="1.2" /><path fill="#fff" stroke="#c00" stroke-width="1" d="M9 7h6v4c0 2-3 3-3 3s-3-1-3-3Z" /><path fill="#039" d="M11.5 8h1v1h-1zm-1 2h1v1h-1zm2 0h1v1h-1zm-1 2h1v1h-1z" /></svg></span><span>Português</span></button>
              <button type="button" data-lang="it" aria-pressed="false" lang="it"><span class="language-option-icon" aria-hidden="true"><svg viewBox="0 0 24 16" focusable="false"><path fill="#009246" d="M0 0h8v16H0z" /><path fill="#fff" d="M8 0h8v16H8z" /><path fill="#ce2b37" d="M16 0h8v16h-8z" /></svg></span><span>Italiano</span></button>
              <button type="button" data-lang="pl" aria-pressed="false" lang="pl"><span class="language-option-icon" aria-hidden="true"><svg viewBox="0 0 24 16" focusable="false"><path fill="#fff" d="M0 0h24v8H0z" /><path fill="#dc143c" d="M0 8h24v8H0z" /></svg></span><span>Polski</span></button>
              <button type="button" data-lang="ar" aria-pressed="false" lang="ar"><span class="language-option-icon" aria-hidden="true"><GlobeIcon /></span><span>العربية</span></button>
            </div>
          </div>
          <a class="header-contact" href="#contact"><span data-i18n="letsTalk">Зв’яжіться з нами</span><span aria-hidden="true">↗</span></a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Відкрити меню" data-i18n-aria="openMenu"><span></span><span></span></button>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Мобільна навігація" data-i18n-aria="mobileNavigation" hidden>
        <a href="#work" data-i18n="navWork">Роботи</a><a href="#services" data-i18n="navServices">Послуги</a><a href="#about" data-i18n="navAbout">Про мене</a><a href="#contact" data-i18n="letsTalk">Зв’яжіться з нами</a>
      </nav>
    </header>
