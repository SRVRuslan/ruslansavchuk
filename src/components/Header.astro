---
import BrandLogo from './BrandLogo.astro';
import GlobeIcon from './GlobeIcon.astro';
---
<header class="header">
      <div class="container header-inner">
        <BrandLogo />
        <nav class="desktop-nav" aria-label="Основна навігація" data-i18n-aria="navigation">
          <a href="#work" data-i18n="navWork">Роботи</a>
          <a href="#services" data-i18n="navServices">Послуги</a>
          <a href="#about" data-i18n="navAbout">Про мене</a>
        </nav>
        <div class="header-actions">
          <div class="language-switch" role="group" aria-label="Мова сайту" data-i18n-aria="languageLabel">
            <button class="language-toggle" type="button" aria-expanded="false" aria-controls="language-options" aria-label="Мова сайту: Українська" lang="uk"><GlobeIcon /><span id="current-language">UA</span><svg class="language-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
            <div class="language-options" id="language-options" hidden>
              <button type="button" data-lang="uk" aria-pressed="true" lang="uk" hidden>Українська</button>
              <button type="button" data-lang="en" aria-pressed="false" lang="en">English</button>
              <button type="button" data-lang="fr" aria-pressed="false" lang="fr">Français</button>
              <button type="button" data-lang="es" aria-pressed="false" lang="es">Español</button>
            </div>
          </div>
          <a class="header-contact" href="#contact"><span data-i18n="letsTalk">Зв’яжіться з нами</span><span aria-hidden="true">↗</span></a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Відкрити меню" data-i18n-aria="openMenu"><span></span><span></span></button>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Мобільна навігація" data-i18n-aria="mobileNavigation" hidden>
        <a href="#work" data-i18n="navWork">Роботи</a><a href="#services" data-i18n="navServices">Послуги</a><a href="#about" data-i18n="navAbout">Про мене</a><a href="#contact" data-i18n="letsTalk">Зв’яжіться з нами</a>
      </nav>
    </header>
