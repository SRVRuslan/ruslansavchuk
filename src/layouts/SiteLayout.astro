---
import "../styles/global.css";
import config from "../data/config.js";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${config.siteUrl}#person`,
      name: config.brand,
      alternateName: config.name.uk,
      url: config.siteUrl,
      jobTitle: ["Web Developer", "Software Engineer"],
      email: config.email,
      knowsAbout: ["Web development", "Astro", "React", "Node.js", "Cloudflare"],
    },
    {
      "@type": "WebSite",
      "@id": `${config.siteUrl}#website`,
      url: config.siteUrl,
      name: config.brand,
      inLanguage: Object.keys(config.name),
      author: { "@id": `${config.siteUrl}#person` },
      publisher: { "@id": `${config.siteUrl}#person` },
    },
  ],
};
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080d15" />
    <meta name="description" content="Незалежний веброзробник. Продумані сайти, інтернет-магазини та вебзастосунки — від першої ідеї до запуску." />
    <link rel="canonical" href={config.siteUrl} />
    <meta property="og:title" content={`${config.brand} — ${config.tagline}`} />
    <meta property="og:description" content="Перетворюю хороші ідеї на сайти, якими приємно користуватися." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={config.siteUrl} />
    <meta property="og:image" content={new URL("/assets/rs-brand-original.png", config.siteUrl).href} />
    <meta property="og:image:alt" content="RS — Ruslan Savchuk. Web Developer · Software Engineer." />
    <meta property="og:locale" content="uk_UA" />
    <meta name="color-scheme" content="dark" />
    <title>{config.brand} — {config.tagline}</title>
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64 128x128 256x256" href="/favicon-v4.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/rs-favicon-v4-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/rs-favicon-v4-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v4.png" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n="skip">Перейти до вмісту</a>
    <slot />
    <script>
      import "../scripts/client.js";
    </script>
  </body>
</html>
